{
  "name": "bee-techy-backend-template",
  "version": "1.0.0",
  "private": true,
  "description": "Bee Techy backend template",
  "author": "Bee Techy <contact@beetechy.com>",
  "scripts": {
    "build": "tsc",
    "check": "vp check",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "dev": "vpx watch src/index.ts --clear-screen=false",
    "format": "vp fmt",
    "lint": "vp lint",
    "prepare": "husky",
    "prisma:generate": "prisma generate",
    "sentry:sourcemaps": "npm run sentry:sourcemaps:inject && npm run sentry:sourcemaps:upload",
    "sentry:sourcemaps:inject": "sentry-cli sourcemaps inject ./build",
    "sentry:sourcemaps:upload": "sentry-cli sourcemaps upload ./build",
    "start": "node build/src/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@aws-sdk/client-ses": "^3.1155.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/node": "^11.8.0",
    "@sentry/profiling-node": "^11.8.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-basic-auth": "^1.2.1",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.3.1",
    "http-errors": "^2.0.1",
    "jsonwebtoken": "^9.0.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/http-errors": "^2.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-plus": "^1.4.0"
  }
}
